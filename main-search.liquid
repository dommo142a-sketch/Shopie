<section class="page-width collection-page"><div class="collection-intro"><p class="eyebrow">FIND YOUR EVERYDAY ESSENTIAL</p><h1>Search</h1><form action="{{ routes.search_url }}" method="get" role="search" class="search-form"><label class="visually-hidden" for="SearchInput">Search products</label><input id="SearchInput" type="search" name="q" value="{{ search.terms | escape }}" placeholder="What are you looking for?"><button class="button button-dark" type="submit">Search</button></form></div>
{% if search.performed %}<p class="muted">{{ search.results_count }} results for “{{ search.terms | escape }}”</p><div class="product-grid">{% for item in search.results %}{% if item.object_type == 'product' %}{% render 'card-product', card_product: item %}{% else %}<article class="product-card"><a class="product-title" href="{{ item.url }}">{{ item.title | escape }}</a></article>{% endif %}{% else %}<p>No results. Try another search.</p>{% endfor %}</div>{% endif %}</section>
{% schema %}{"name":"Main search","settings":[]}{% endschema %}