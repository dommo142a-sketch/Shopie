<section class="page-width values-section"><div class="section-heading"><div><p class="eyebrow">THE NORTHLINE STANDARD</p><h2>{{ section.settings.title | escape }}</h2></div></div><div class="values-grid">{% for block in section.blocks %}<div class="value-card" {{ block.shopify_attributes }}><span class="value-number">0{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3><div class="rte">{{ block.settings.text }}</div></div>{% endfor %}</div></section>
{% schema %}{"name":"Multicolumn","settings":[{"type":"text","id":"title","label":"Heading","default":"A better everyday starts small"},{"type":"text","id":"text","label":"Intro"}],"blocks":[{"type":"column","name":"Column","settings":[{"type":"text","id":"title","label":"Heading","default":"Thoughtful utility"},{"type":"richtext","id":"text","label":"Text","default":"<p>Useful things, chosen with care.</p>"}]}],"presets":[{"name":"Multicolumn","blocks":[{"type":"column"},{"type":"column"},{"type":"column"}]}]}{% endschema %}