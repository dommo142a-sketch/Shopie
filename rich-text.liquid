<section class="rich-text-section page-width"><p class="eyebrow">{{ section.settings.eyebrow | escape }}</p><h2>{{ section.settings.heading | escape }}</h2><div class="rte">{{ section.settings.text }}</div>{% if section.settings.button_label != blank %}<a class="text-link" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }} ↗</a>{% endif %}</section>
{% schema %}{"name":"Rich text","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"OUR POINT OF VIEW"},{"type":"text","id":"heading","label":"Heading","default":"Useful by design."},{"type":"richtext","id":"text","label":"Text","default":"<p>We believe the things you use every day should earn their place.</p>"},{"type":"text","id":"button_label","label":"Button label"},{"type":"url","id":"button_link","label":"Button link"}],"presets":[{"name":"Rich text"}]}{% endschema %}