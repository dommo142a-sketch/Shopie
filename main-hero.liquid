<section class="hero-section">
  <div class="hero-copy">
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    <p class="hero-description">{{ section.settings.description | escape }}</p>
    <a class="button button-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></a>
    <div class="hero-note"><span class="note-line"></span><span>{{ section.settings.note | escape }}</span></div>
  </div>
  <div class="hero-art" role="img" aria-label="Minimal illustration of a tidy desk with an organiser, notebook and lamp">
    <div class="art-sun"></div><div class="art-poster"><span>MAKE<br>ROOM<br>TO THINK.</span><small>01 / EVERYDAY</small></div>
    <div class="art-desk"></div><div class="art-laptop"></div><div class="art-organiser"><i></i><i></i><i></i></div><div class="art-book"></div><div class="art-vase"><b></b></div>
    <div class="art-caption">A LITTLE MORE SPACE.</div>
  </div>
</section>
{% schema %}
{"name":"Northline hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A CLEARER KIND OF EVERYDAY"},{"type":"text","id":"heading","label":"Heading","default":"Make space for what matters."},{"type":"textarea","id":"description","label":"Description","default":"Thoughtful desk and home essentials that bring a little more calm to your everyday routine."},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"text","id":"note","label":"Small note","default":"Useful things. Considered design."}]}
{% endschema %}