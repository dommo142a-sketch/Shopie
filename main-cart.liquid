<section class="page-width cart-page"><p class="eyebrow">YOUR NORTHLINE BAG</p><h1>Your bag{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}</h1>
{% if cart.item_count == 0 %}<div class="empty-cart"><p>Your bag is taking a breather.</p><a class="button button-dark" href="{{ routes.all_products_collection_url }}">Explore the collection</a></div>
{% else %}
<form action="{{ routes.cart_url }}" method="post" novalidate><div class="cart-lines">{% for item in cart.items %}<div class="cart-line"><a href="{{ item.url }}">{% if item.image %}{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.title }}{% else %}<div class="product-placeholder"></div>{% endif %}</a><div class="cart-line-info"><a class="product-title" href="{{ item.url }}">{{ item.product.title | escape }}</a><p>{{ item.final_price | money }}</p><label for="updates_{{ item.key }}">Qty</label><input id="updates_{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0"><a class="text-link" href="{{ item.url_to_remove }}">Remove</a></div><strong>{{ item.final_line_price | money }}</strong></div>{% endfor %}</div><div class="cart-summary"><label for="CartNote">Order note (optional)</label><textarea id="CartNote" name="note">{{ cart.note }}</textarea><button class="button button-light" type="submit" name="update">Update bag</button><div class="cart-total"><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div><p class="muted small">Shipping and taxes are calculated at checkout.</p><button class="button button-dark button-full" type="submit" name="checkout">Continue to checkout</button></div></form>
{% endif %}</section>
{% schema %}{"name":"Main cart","settings":[]}{% endschema %}